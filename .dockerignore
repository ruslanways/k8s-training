.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Kubernetes manifests are applied from the host, not needed in the image
manifests/

# Docker
Dockerfile
.dockerignore

# Environment / secrets
.env
.env.*
*.pem
*.key
kubeconfig
.kube/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
