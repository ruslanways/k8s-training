# Template for manifests/secret.yaml, which is git-ignored so real values stay local.
# The .yaml.example extension keeps "kubectl apply -f manifests/" from applying it.
#
#   cp manifests/secret.yaml.example manifests/secret.yaml
#   # then edit in the real value
#
# Alternative that keeps the value out of any file:
#   kubectl create secret generic app-secret --from-literal=API_KEY='...'
#
# Note: stringData is plain text in the manifest; Kubernetes base64-encodes it
# into data at write time. Base64 is encoding, not encryption -- anyone who can
# read the Secret in the cluster can read the value back.
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
type: Opaque
stringData:
  API_KEY: "replace-me"
